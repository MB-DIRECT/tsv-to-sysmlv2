#set($e0=$el.end.get(0))
#if($e0.partWithPort && $e0.partWithPort.qualifiedName)#set($SPWP=$e0.partWithPort.qualifiedName)#end
#elseif($mc == "ConnectorEnd" && $el.partWithPort && $el.partWithPort.qualifiedName)
#set($SPWP=$el.partWithPort.qualifiedName)
#end
## ── COL 12: Target / Supplier QN ─────────────────────────────────────────────
