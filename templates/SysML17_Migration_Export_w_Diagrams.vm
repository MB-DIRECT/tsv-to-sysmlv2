#if($mc == "ControlFlow" || $mc == "ObjectFlow" || $mc == "Transition")
#if($el.target && $el.target.qualifiedName)#set($TGT=$el.target.qualifiedName)#end
#elseif($mc == "Abstraction" || $mc == "Dependency")
#foreach($s in $el.supplier)#if($TGT!="")#set($TGT="$TGT, ")#end#set($TGT="$TGT$s.qualifiedName")#end
#elseif($mc == "InformationFlow")
#foreach($t in $el.informationTarget)#if($TGT!="")#set($TGT="$TGT, ")#end#set($TGT="$TGT$t.qualifiedName")#end
#end
